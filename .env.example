# Contact form. Get a key at https://web3forms.com (verify an email, no account).
# 250 submissions a month, free. Without it the form says so and shows your
# address instead of silently failing.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Used for absolute URLs in social cards. Set to your Vercel URL after deploying.
NEXT_PUBLIC_SITE_URL=
