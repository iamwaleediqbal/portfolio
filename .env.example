# Contact form. Get a key at https://web3forms.com (verify an email, no account).
# 250 submissions a month, free. Without it the form says so and shows your
# address instead of silently failing.
NEXT_PUBLIC_WEB3FORMS_KEY=

# The deployed origin. It becomes `metadataBase`, which is what makes the social
# card image an absolute URL — so if it is wrong, every link preview of this site
# silently shows no image and nothing else looks broken. Set it to the exact
# origin you deploy to, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://waleediqbal.vercel.app
